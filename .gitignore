# Secrets generes au premier deploiement (server/deploy-server.sh) -
# jamais les memes d'un lab a l'autre, ne doivent pas finir dans git.
server/stacks/bastion/bastion.env

# Optionnel : token API Dockhand, uniquement si l'authentification est
# activee dans Dockhand (desactivee par defaut) - voir server/dockhand-api.sh.
server/dockhand.env

# Etat runtime de Bastion (inventaire de machines, identifiants
# chiffres, historique de disponibilite, certificats TLS auto-signes
# generes localement) - donnees de test, pas de l'infra-as-code.
server/stacks/bastion/config/
server/stacks/bastion/maps/

# Caddyfile regenere a chaque deploiement par server/render-caddyfile.py
# a partir de server/services.yaml (la vraie source de verite).
server/stacks/caddy/Caddyfile

# Config TLS (mode + domaine signe + identifiants API OVH pour le DNS-01)
# - editable a la main ou depuis caddy-admin, jamais les memes d'un lab a
# l'autre, ne doit jamais finir dans git.
server/stacks/caddy/tls.env

# Certificats TLS + cle privee de la CA interne (mode internal) - etat
# runtime propre a chaque lab, jamais commite (secrets).
server/stacks/caddy/data/
server/stacks/caddy/config/

# Baux DHCP - etat runtime, pas de l'infra-as-code.
server/stacks/dnsmasq/data/

# Reservations DHCP + enregistrements DNS statiques, geres depuis
# dnsmasq-admin - propres a chaque lab, pas de l'infra-as-code.
server/stacks/dnsmasq/admin-config/

# Clones bare git + config des mirroirs (mirrors.yaml, tokens compris) -
# etat runtime propre a chaque lab, pas de l'infra-as-code.
server/stacks/git-mirror/data/

# Secrets ansible-web (BASTION_API_TOKEN, config du mirroir git-mirror
# utilise) + cle SSH dediee automatisation pour bastion-ansible - jamais
# les memes d'un lab a l'autre, cle distincte de toute cle de vraie
# production.
server/stacks/ansible-web/ansible-web.env
server/stacks/ansible-web/automation_key/
server/stacks/ansible-web/config.yaml

# Clone de travail (depuis git-mirror) + historique des runs - etat
# runtime propre a chaque lab, pas de l'infra-as-code.
server/stacks/ansible-web/repo/
server/stacks/ansible-web/runs/

# Config WireGuard generee (cles, pairs) - jamais la meme d'un lab a
# l'autre, ne doit jamais finir dans git (secrets client compris).
vpn/wireguard/config/

# Fichiers auto-generes par Homepage au demarrage dans son dossier de
# config (monte directement sur server/stacks/dashboard/config/, qui
# contient par ailleurs nos fichiers versionnes services.yaml/settings.yaml) -
# etat runtime, pas de l'infra-as-code.
server/stacks/dashboard/config/logs/
server/stacks/dashboard/config/kubernetes.yaml

# HOMEPAGE_ALLOWED_HOSTS - regenere a chaque deploiement/changement TLS
# (deploy-server.sh ou caddy-admin) a partir du domaine public actuel,
# jamais en dur - voir server/stacks/dashboard/docker-compose.yml.
server/stacks/dashboard/dashboard.env

# Liste de liens Homepage generee depuis services.yaml.template (celui-ci
# reste versionne, a editer a la main) - meme raison que le point
# precedent, voir son en-tete.
server/stacks/dashboard/config/services.yaml

# Bytecode Python (genere localement par un simple `python -m py_compile`
# de verification syntaxique, jamais volontairement).
__pycache__/
