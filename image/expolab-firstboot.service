[Unit]
Description=expolab : personnalisation au premier demarrage (cles SSH d'hote, Wi-Fi, cles autorisees)
# Avant le reseau (le hostname est annonce au DHCP) et avant sshd (cles d'hote).
After=local-fs.target
Before=network-pre.target NetworkManager.service ssh.service sshd.service
Wants=network-pre.target
ConditionPathExists=|/boot/firmware/expolab.conf
ConditionPathExists=|/boot/expolab.conf
ConditionPathExists=|!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/expolab-firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
